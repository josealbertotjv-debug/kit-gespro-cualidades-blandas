# =============================================================================
# Kit-GesPro (GP-13) · Variables de entorno
# Copie este archivo a .env (en el servidor Vultr: /opt/gespro/kit-cualidades-blandas/.env)
# y complete los valores. NUNCA suba .env al repositorio.
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=4500

# ── Base de datos (PostgreSQL compartido de gespro-costos, esquema "kit") ─────
# Si se deja vacío se usa SQLite local en ./data (solo desarrollo).
# Si PostgreSQL corre en el mismo servidor Vultr fuera de Docker, use host.docker.internal.
DATABASE_URL=postgresql://kit_gp13:CAMBIAR_PASSWORD@host.docker.internal:5432/gespro_costos
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Aplica sql/kit_soft_skills_360_migration.sql al arrancar (idempotente).
# Póngalo en false si el DBA aplica las migraciones manualmente (npm run migrate).
DB_AUTO_MIGRATE=true

# Carga empleados/ciclos/evaluaciones de demostración si la tabla de evaluaciones está vacía.
# En producción con datos reales: false.
SEED_DEMO_DATA=false

# ── Seguridad HTTP ────────────────────────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma). Vacío = sin CORS. "*" = cualquiera.
CORS_ORIGIN=https://gespro.ejemplo.com
# Quién puede embeber la app en un iframe (p. ej. el portal GesPro). Ej: self https://gespro.ejemplo.com
FRAME_ANCESTORS=self
# Autenticación HTTP Basic de la app (recomendada mientras no exista SSO GesPro). /healthz queda libre.
BASIC_AUTH_USER=gespro
BASIC_AUTH_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA
# Permitir que el ingestor web descargue URLs de redes privadas (NO recomendado).
INGEST_ALLOW_PRIVATE_HOSTS=false

# ── Docker / despliegue ───────────────────────────────────────────────────────
# Imagen publicada por GitHub Actions en GHCR
IMAGE=ghcr.io/josealbertotjv-debug/kit-gespro-cualidades-blandas:latest
# Puerto local donde Nginx encontrará la app
HOST_PORT=4500
